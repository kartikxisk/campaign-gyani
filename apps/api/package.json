{
  "name": "@cg/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@prisma/client": "6.2.1",
    "@cg/shared": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "helmet": "8.0.0",
    "cookie-parser": "1.4.7",
    "zod": "3.24.1",
    "dotenv": "16.4.7",
    "@node-rs/argon2": "2.0.2",
    "express-session": "1.18.1",
    "connect-redis": "8.0.1",
    "redis": "4.7.0",
    "@nestjs/throttler": "6.3.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.16",
    "ipaddr.js": "2.2.0",
    "csv-parse": "5.6.0",
    "bullmq": "5.34.6",
    "ioredis": "5.4.2"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "prisma": "6.2.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "unplugin-swc": "1.5.1",
    "@swc/core": "1.10.7",
    "vitest": "2.1.8",
    "@types/express-session": "1.18.1",
    "@types/multer": "1.4.12",
    "@types/nodemailer": "6.4.17"
  }
}
